{
  "name": "dnd",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "homepage": "http://highdynamics.github.io/dnd-app",
  "scripts": {
    "mobile-url": "ifconfig | grep 192.168 | awk '{print \"http://\"$2\":3000\"}'",
    "start": "vite --host",
    "build": "vite build",
    "serve": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.1",
    "@headlessui/react": "^1.7.18",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.18",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router": "^7.7.1",
    "recoil": "0.7.7",
    "swr": "2.2.4"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "gh-pages": "6.1.1",
    "json-loader": "0.5.7",
    "miragejs": "0.1.48",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.11",
    "typescript": "5.3.3",
    "vite": "^7.0.6"
  }
}
