# Copy to .env for local development (.env is gitignored).

# Option A: a single connection string (what Render provides). SSL is on by
# default for managed Postgres; set DATABASE_SSL=false for a local URL.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=false

# Option B: discrete vars for a local Postgres (used when DATABASE_URL is unset).
# Unset values fall back to the pg defaults (localhost, your OS user).
PGDATABASE=herofolio
# PGHOST=localhost
# PGPORT=5432
# PGUSER=
# PGPASSWORD=

# Postgres schema this app's tables live in (defaults to "herofolio"), so the
# database can be shared with other projects.
# DB_SCHEMA=herofolio

# --- Accounts ------------------------------------------------------------
# Signs the session cookie. Use a long random value; REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-insecure-secret

# Sign-up requires this code; leave it unset to turn sign-up off.
SIGNUP_INVITE_CODE=

# Your account: it owns Arn and all non-SRD seed data, and is given this
# password on boot if it doesn't have one yet. Store only the bcrypt HASH:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'your-password'
BOOTSTRAP_USER_EMAIL=you@example.com
BOOTSTRAP_USER_PASSWORD_HASH=
